{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrandProtectionProfile",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    },
    "brand_slug": {
      "type": "string",
      "pattern": "[a-z0-9]+(?:-[a-z0-9]+)*",
      "maxLength": 80
    },
    "brand_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "legal_entity_name_en": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "legal_entity_name_local": {
      "type": "string"
    },
    "entity_address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "authorized_signatory": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "legal_email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "phone": {
          "type": "string"
        },
        "forwarded_gmail": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "legal_email"
      ],
      "additionalProperties": false
    },
    "official_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowlist_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true
    },
    "official_product_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "counterfeit_warning_url": {
      "type": "string"
    },
    "target_markets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "US",
          "CA",
          "EU",
          "UK",
          "AU",
          "CN_EXPORT",
          "GLOBAL"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "product_risk_profile": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "high_power_lithium_mobility",
            "electronics_battery",
            "children_or_medical",
            "automotive_parts",
            "general_consumer_goods"
          ]
        },
        "safety_standards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "hazard_statement_en": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "keyword_watch_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120
      },
      "uniqueItems": true
    },
    "trademarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "enum": [
              "US",
              "CA",
              "EU",
              "UK",
              "AU",
              "CN"
            ]
          },
          "reg_number": {
            "type": "string",
            "maxLength": 120
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "cert_file_path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "registered",
              "pending",
              "common_law"
            ]
          },
          "mark_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "nice_classes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 45
            }
          }
        },
        "required": [
          "jurisdiction",
          "mark_text",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "patents_and_designs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "enum": [
              "US",
              "CA",
              "EU",
              "UK",
              "AU",
              "CN"
            ]
          },
          "reg_number": {
            "type": "string",
            "maxLength": 120
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          },
          "cert_file_path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "registered",
              "pending",
              "common_law"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "design",
              "utility"
            ]
          },
          "product_model": {
            "type": "string"
          },
          "drawings_file_path": {
            "type": "string"
          }
        },
        "required": [
          "jurisdiction",
          "type",
          "reg_number"
        ],
        "additionalProperties": false
      }
    },
    "copyright_originals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "official_source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "first_published_date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "asset_name",
          "official_source_url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "brand_slug",
    "brand_name",
    "legal_entity_name_en",
    "entity_address",
    "authorized_signatory",
    "official_domains",
    "target_markets"
  ],
  "additionalProperties": false
}
